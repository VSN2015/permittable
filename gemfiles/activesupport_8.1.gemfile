# Compatibility gemfile: activesupport 8.1.x — see gemfiles/README.md.
source "https://rubygems.org"

gemspec path: ".."

gem "activesupport", "~> 8.1.0"

# Dev/test only, matched to the pinned line: actionpack drives the
# real-ActionController integration specs, activerecord + sqlite3 the
# schema-drift specs.
gem "actionpack", "~> 8.1.0"
gem "activerecord", "~> 8.1.0"
# activesupport 8.1 depends on json unconstrained, and 8.1.3.1 cannot decode
# with json 3 (the 6.1-8.0 lines use the json that ships with Ruby, so they
# need no pin). Remove with the root Gemfile's pin:
# https://github.com/VSN2015/permittable/issues/58
gem "json", "< 3"
gem "rake"
gem "rspec", "~> 3.12"
gem "simplecov", "~> 1.1"
gem "sqlite3", "~> 2.1"
