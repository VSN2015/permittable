# Compatibility gemfile: activesupport 6.1.x — see gemfiles/README.md.
source "https://rubygems.org"

gemspec path: ".."

gem "activesupport", "~> 6.1.0"

# Dev/test only, matched to the pinned line: actionpack drives the
# real-ActionController integration specs, activerecord + sqlite3 the
# schema-drift specs, railties the booted-app Railtie specs.
gem "actionpack", "~> 6.1.0"
gem "activerecord", "~> 6.1.0"
gem "railties", "~> 6.1.0"
gem "rake"
gem "rspec", "~> 3.12"
gem "simplecov", "~> 1.1"
gem "sqlite3", "~> 1.4"
