# Compatibility gemfile: activesupport 8.0.x — see gemfiles/README.md.
source "https://rubygems.org"

gemspec path: ".."

gem "activesupport", "~> 8.0.0"

# Dev/test only, matched to the pinned line: actionpack drives the
# real-ActionController integration specs, activerecord + sqlite3 the
# schema-drift specs.
gem "actionpack", "~> 8.0.0"
gem "activerecord", "~> 8.0.0"
gem "rake"
gem "rspec", "~> 3.12"
gem "simplecov", "~> 1.1"
gem "sqlite3", "~> 2.1"
